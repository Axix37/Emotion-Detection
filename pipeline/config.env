# ============================================================
#  SQL Server -> Excel -> PowerPoint Pipeline  —  Config
#  Fill in your real values. Never commit passwords to source control.
# ============================================================

# ------ SQL Server connection --------------------------------
SQL_SERVER=YOUR_SERVER_NAME\INSTANCE      # e.g. MYSERVER\SQLEXPRESS  or  192.168.1.10
SQL_DATABASE=YourDatabase

# Leave SQL_USERNAME and SQL_PASSWORD blank to use Windows Authentication (recommended).
# Set both if you use SQL Server Authentication.
SQL_USERNAME=
SQL_PASSWORD=

# ODBC driver — run odbcad32 to check installed drivers.
# Common values: "ODBC Driver 17 for SQL Server"  |  "ODBC Driver 18 for SQL Server"
SQL_DRIVER=ODBC Driver 17 for SQL Server

# ------ Queries -----------------------------------------------
# MA% query  (values must be decimals 0–1, e.g. 0.9512 = 95.12%)
# Required columns: Tool, Target, WW_n, WW_n-1, ...
SQL_QUERY=SELECT TOP 50 * FROM dbo.YourMATable

# CT (Cycle Time) query  — leave blank to show a placeholder on the slide.
# Required columns: Tool, Target, WW_n, WW_n-1, ...
CT_QUERY=

# ------ Column names ------------------------------------------
# Names of the tool-label and target columns in your query results.
TOOL_COLUMN=Tool
TARGET_COLUMN=Target

# ------ Output ------------------------------------------------
# Absolute path where Excel + PowerPoint files are saved.
# Default: pipeline\output\  (relative to script location)
OUTPUT_DIR=

# ------ PowerPoint layout -------------------------------------
# Maximum data rows shown on the slide (rest still in Excel).
PPT_MAX_ROWS=25

# Slide title (top-left, large text)
SLIDE_TITLE=Weekly MA% & Cycle Time Report

# Optional full-width banner below the title divider.
# Example: "Key Takeaway: Upgrades in FIN1 caused DT thru Finishing."
# Leave blank to omit the banner entirely.
KEY_TAKEAWAY=

# Section banner labels (appear above each table)
MA_LABEL=Machine Availability % (MA%)
CT_LABEL=Cycle Time (CT)
