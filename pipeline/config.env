# ============================================================
#  SQL Server -> Excel -> PowerPoint Pipeline  —  Config
#  Copy this file as-is and fill in your real values.
#  Never commit passwords to source control.
# ============================================================

# ------ SQL Server connection --------------------------------
SQL_SERVER=YOUR_SERVER_NAME\INSTANCE      # e.g. MYSERVER\SQLEXPRESS  or  192.168.1.10
SQL_DATABASE=YourDatabase

# Leave SQL_USERNAME and SQL_PASSWORD blank to use Windows Authentication (recommended on-prem).
# Set both if you use SQL Server Authentication.
SQL_USERNAME=
SQL_PASSWORD=

# ODBC driver name — run `odbcad32` to check installed drivers.
# Common values: "ODBC Driver 17 for SQL Server"  |  "ODBC Driver 18 for SQL Server"
SQL_DRIVER=ODBC Driver 17 for SQL Server

# ------ Query ------------------------------------------------
# Replace with your actual SELECT statement.
# Tip: wrap a complex query in a stored-proc call:
#   SQL_QUERY=EXEC dbo.usp_WeeklyReport
SQL_QUERY=SELECT TOP 50 * FROM dbo.YourTable

# ------ Output -----------------------------------------------
# Absolute path where Excel + PowerPoint files will be saved.
# Default: pipeline/output/  (relative to script location)
OUTPUT_DIR=

# ------ PowerPoint layout ------------------------------------
# Maximum data rows shown on the slide (remainder still in Excel).
PPT_MAX_ROWS=25
