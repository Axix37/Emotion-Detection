# ============================================================
#  Shorts Bot  —  Config
#  Fill in your values. Never commit real keys to source control.
# ============================================================

# ------ Claude (script writing) ------------------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# What your channel is about. Be specific — narrow niches grow faster.
# e.g. "surprising space facts", "money-saving tips for students", "1-minute history stories"
NICHE=surprising science facts most people never learned in school

# Optional extra direction for every script (tone, audience, things to avoid).
EXTRA_INSTRUCTIONS=

# ------ Voice ------------------------------------------------
# Any Microsoft Edge neural voice. List them with:  edge-tts --list-voices
VOICE=en-US-AndrewMultilingualNeural
VOICE_RATE=+8%

# Background music: drop royalty-free .mp3 files into shorts_bot/music/
# (e.g. from the YouTube Audio Library). One is picked at random per video.
MUSIC_VOLUME=0.12

# Optional: path to a bold .ttf font for captions.
FONT_PATH=

# ------ Where to post ----------------------------------------
# Comma-separated: youtube, tiktok
PLATFORMS=youtube,tiktok

# ------ YouTube ----------------------------------------------
# private | unlisted | public   (start with private, review a few, then switch to public)
YOUTUBE_PRIVACY=private
# 27 = Education, 24 = Entertainment, 22 = People & Blogs
YOUTUBE_CATEGORY_ID=27
# Discloses AI-generated voice/visuals to YouTube. Keep true.
YOUTUBE_SYNTHETIC_MEDIA=true

# ------ TikTok -----------------------------------------------
# From https://developers.tiktok.com  (app with Content Posting API + video.publish scope)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your TikTok app.
TIKTOK_REDIRECT_URI=
# SELF_ONLY until TikTok audits your app; then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# ------ Output -----------------------------------------------
# Default: shorts_bot/output/
OUTPUT_DIR=
